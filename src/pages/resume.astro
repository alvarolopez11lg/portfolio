---
// To update the resume, replace public/resume.pdf with the new file (same name).
import Layout from '../layouts/Layout.astro';
---

<Layout title="Resume">
  <div class="stack">
    <p><a class="link" href="/resume.pdf" download="Alvaro_Lopez_Guerra_Resume.pdf">Download PDF ↓</a></p>
    <object class="pdf" data="/resume.pdf#view=FitH" type="application/pdf" aria-label="Resume PDF">
      <p><a class="link" href="/resume.pdf">Open the resume PDF</a></p>
    </object>
  </div>
</Layout>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .link {
    border-bottom: 1px solid currentColor;
  }

  .link:hover {
    color: var(--accent);
  }

  .pdf {
    width: 100%;
    height: 80vh;
    border: 1px solid var(--rule);
  }

  @media (max-width: 800px) {
    .pdf {
      display: none;
    }
  }
</style>
