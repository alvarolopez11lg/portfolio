---
import Layout from '../../layouts/Layout.astro';
import ProjectView from '../../components/ProjectView.astro';
import { projectPaths } from '../../lib/projects';

export async function getStaticPaths() {
  return projectPaths('completed', '/projects');
}

const { project, prev, next } = Astro.props;
---

<Layout title={project.data.title} description={project.data.hook}>
  <ProjectView project={project} prev={prev} next={next} />
</Layout>
