---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact">
  <dl class="rows">
    <dt>Email</dt>
    <dd><a href="mailto:al5072@columbia.edu">al5072@columbia.edu</a></dd>
    <dt>LinkedIn</dt>
