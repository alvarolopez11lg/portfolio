<style>
  .rows {
    display: grid;
    grid-template-columns: 6.5em minmax(0, 1fr);
    row-gap: 10px;
    margin: 0;
  }

  .rows dt {
    color: var(--muted);
  }

  .rows dd {
    margin: 0;
  }

  .rows a {
    border-bottom: 1px solid currentColor;
  }

  .rows a:hover {
    color: var(--accent);
  }
</style>
