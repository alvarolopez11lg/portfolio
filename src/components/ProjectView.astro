---
// How one project is shown in the content area. Every project uses this,
// so a change here updates them all. A group page (like EngiWorks) shows
// its intro, then each member project nested underneath.
import { Image } from 'astro:assets';
import { getEntry, render, type CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  nested?: boolean;
  prev?: { href: string; title: string };
  next?: { href: string; title: string };
}

const { project, nested = false, prev, next } = Astro.props;
const { title, hook, context, tools, cover, coverAlt, gallery, members } = project.data;
const { Content } = await render(project);
const parts = (await Promise.all(members.map((m) => getEntry(m)))).filter((p) => p !== undefined);
const Heading = nested ? 'h2' : 'h1';
---

<article class:list={['project', { nested }]} id={nested ? project.id : undefined}>
  <header class="head">
    <Heading class="title">{title}</Heading>
    <p class="hook">{hook}</p>
    <p class="meta muted">{context}</p>
    {tools.length > 0 && <p class="meta muted">{tools.join(' · ')}</p>}
  </header>

  {
    cover && (
      <figure class="cover">
        <Image
          src={cover}
          alt={coverAlt ?? title}
          widths={[480, 760, 1200]}
          sizes="(max-width: 800px) 100vw, 760px"
          style={`--maxw: ${Math.round(cover.width * 1.4)}px`}
        />
      </figure>
    )
  }

  <div class="body">
    <Content />
  </div>

  {
    gallery.length > 0 && (
      <div class="gallery">
        {gallery.map((g) => (
          <figure class:list={[{ wide: g.wide }]}>
            <div class="frame">
              <Image
                src={g.src}
                alt={g.alt}
                widths={g.wide ? [760, 1200] : [360, 720]}
                sizes={g.wide ? '(max-width: 800px) 100vw, 760px' : '(max-width: 800px) 50vw, 370px'}
                style={`--maxw: ${Math.round(g.src.width * 1.4)}px`}
              />
            </div>
            {g.caption && (
              <figcaption class="muted">
                {g.caption}
                {g.link && (
                  <>
                    {' '}
                    <a href={g.link} rel="noopener">
                      Source ↗
                    </a>
                  </>
                )}
              </figcaption>
            )}
          </figure>
        ))}
      </div>
    )
  }

  {
    parts.length > 0 && (
      <div class="parts">
        {parts.map((part) => (
          <Astro.self project={part} nested />
        ))}
      </div>
    )
  }

  {
    !nested && (prev || next) && (
      <nav class="pager" aria-label="More projects">
        {prev ? (
          <a href={prev.href}>
            <span class="muted">Previous</span>
            <br />
            {prev.title}
          </a>
        ) : (
          <span />
        )}
        {next && (
          <a href={next.href} class="right">
            <span class="muted">Next</span>
            <br />
            {next.title}
          </a>
        )}
      </nav>
    )
  }
</article>

<style>
  .project {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .nested {
    padding-top: 40px;
    border-top: 1px solid var(--rule);
    scroll-margin-top: 24px;
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .title {
    font-size: 1.4rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .nested .title {
    font-size: 1.15rem;
  }

  .hook {
    margin-bottom: 8px;
  }

  .meta {
    font-size: 0.87rem;
  }

  figure {
    margin: 0;
  }

  .cover,
  .frame {
    display: flex;
    justify-content: center;
    align-items: center;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--rule);
    overflow: hidden;
  }

  .cover {
    max-height: 480px;
  }

  /* Images are never enlarged more than 1.4x their real size, so they stay sharp. */
  .cover :global(img),
  .frame :global(img) {
    width: var(--maxw);
    max-width: 100%;
    height: auto;
    max-height: 100%;
    object-fit: contain;
    padding: 16px;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 62ch;
  }

  .body :global(h2) {
    margin-top: 12px;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .body :global(p),
  .body :global(ul) {
    margin: 0;
  }

  .body :global(ul) {
    padding-left: 1.2em;
  }

  .body :global(li + li) {
    margin-top: 6px;
  }

  .body :global(a),
  figcaption a {
    border-bottom: 1px solid currentColor;
  }

  .body :global(a:hover),
  figcaption a:hover {
    color: var(--accent);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .gallery .wide {
    grid-column: 1 / -1;
  }

  .gallery .wide .frame {
    aspect-ratio: auto;
  }

  figcaption {
    margin-top: 8px;
    font-size: 0.87rem;
  }

  .parts {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
  }

  .pager a:hover {
    color: var(--accent);
  }

  .right {
    text-align: right;
  }
</style>
