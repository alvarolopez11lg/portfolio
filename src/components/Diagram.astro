---
// A wide figure (diagram, drawing) that opens full size when clicked.
// `full` is the address of the full-size file in /public.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  full?: string;
  caption?: string;
}

const { src, alt, full, caption } = Astro.props;
---

<figure class="diagram">
  {
    full ? (
      <a href={full} target="_blank" rel="noopener" aria-label={`${alt} (open full size)`}>
        <Image src={src} alt={alt} widths={[760, 1200, 1600]} sizes="(max-width: 800px) 100vw, 760px" />
      </a>
    ) : (
      <Image src={src} alt={alt} widths={[760, 1200, 1600]} sizes="(max-width: 800px) 100vw, 760px" />
    )
  }
  {
    (caption || full) && (
      <figcaption class="muted">
        {caption}
        {full && (
          <>
            {caption ? ' ' : ''}
            <a href={full} target="_blank" rel="noopener">
              Open full size ↗
            </a>
          </>
        )}
      </figcaption>
    )
  }
</figure>

<style>
  .diagram {
    margin: 8px 0;
  }

  .diagram > a {
    display: block;
    border: 1px solid var(--rule);
  }

  .diagram :global(img) {
    width: 100%;
    height: auto;
  }

  figcaption {
    margin-top: 8px;
    font-size: 0.87rem;
  }

  figcaption a {
    border-bottom: 1px solid currentColor;
  }

  figcaption a:hover {
    color: var(--accent);
  }
</style>
